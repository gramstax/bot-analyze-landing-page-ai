# Telegram bot token from @BotFather (required for the bot)
BOT_TOKEN=

# OpenAI-compatible AI provider. Optional when OPENAI_BASE_URL points at a
# keyless provider (e.g. Pollinations, see README).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=o1
# OPENAI_REASONING_EFFORT=high

# Port for the HTTP endpoint (bun run serve)
ANALYZE_PORT=3002

# Comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ANALYZE_ALLOWED_IDS=

# 1 = force the deterministic mock analyzer (used by e2e tests)
ANALYZE_MOCK_AI=
